import sys
from collections import Counter

lines = []

for line in sys.stdin:
    line = line.rstrip("\n")

    if line.strip() == "":
        continue

    lines.append(line)

counts = Counter(lines)

for line, count in sorted(counts.items(), key=lambda item: (-item[1], item[0])):
    print(f"{count}\t{line}")